# =============================================================================
# AutomatizIA - Environment variables
# Copy this file to .env.local and fill in real values.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# Cloud: Dashboard, Project Settings, API. Copy URL, anon key, service_role.
# Local: defaults from `supabase start` (URL http://127.0.0.1:54321).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Database connection for Drizzle.
#
# Option A) DATABASE_URL (one string). Works for most cases but the URL parser
#   percent-decodes the password: characters like % : @ / # in your password
#   need to be %25 %3A %40 %2F %23 or the password is silently corrupted.
# Cloud: Dashboard, Project Settings, Database, Connection string (URI).
#   Use the Session pooler URI on port 5432 for serverless deployments.
# Local: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# -----------------------------------------------------------------------------
DATABASE_URL=

# -----------------------------------------------------------------------------
# Option B) Component form (preferred when the password has special chars).
# If DATABASE_HOST is set, the components below win and DATABASE_URL is ignored.
# Cloud (session pooler example):
#   DATABASE_HOST=aws-1-eu-central-2.pooler.supabase.com
#   DATABASE_PORT=5432
#   DATABASE_USER=postgres.pvkshklkclrsmrcgjgch
#   DATABASE_PASSWORD=your-raw-password-with-no-escaping
#   DATABASE_NAME=postgres
#   DATABASE_SSL=require            # set to "false" for local supabase
# -----------------------------------------------------------------------------
DATABASE_HOST=
DATABASE_PORT=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
DATABASE_SSL=

# -----------------------------------------------------------------------------
# Anthropic
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Google OAuth (configure in Supabase dashboard once available)
# Leave empty in Phase 1, the button stays disabled.
# -----------------------------------------------------------------------------
GOOGLE_OAUTH_ENABLED=false
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Stripe (Phase 2, leave empty for now)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
